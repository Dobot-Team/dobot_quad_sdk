{
    "python.analysis.extraPaths": [
        "${workspaceFolder}/high_level/python"
    ],
    "python.analysis.autoSearchPaths": true,
    "clangd.arguments": [
        "--query-driver=/usr/bin/**/c++,/usr/bin/**/g++",
        "--background-index",
        "--clang-tidy"
    ],
    "files.exclude": {
        "**/build": true,
        "**/*.egg-info": true,
        "**/__pycache__": true
    }
}
